# PostgreSQL Configuration
POSTGRES_USER=subnode
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=subnode

# JWT Configuration
JWT_SECRET=change-this-in-production
JWT_EXPIRY=60

# Initial admin account (seeded on first boot of an empty database).
# ADMIN_PASSWORD is required in release mode and may not be "admin".
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# CORS Configuration
CORS_ALLOWED_ORIGINS=*

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=15
