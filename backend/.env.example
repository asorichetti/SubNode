# Server Configuration
SERVER_PORT=8080
SERVER_MODE=release

# Database Configuration
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=subnode
DB_USER=subnode
DB_PASSWORD=change-me-in-production
DB_SSLMODE=disable
DB_SQLITE_PATH=subnode.db

# JWT Configuration
JWT_SECRET=change-this-in-production
JWT_EXPIRY=60

# CORS Configuration
CORS_ALLOWED_ORIGINS=*

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=15
